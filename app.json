{
  "$schema": "./.vscode/schemas/expo-xdl.json",
  "expo": {
    "name": "MediMate",
    "slug": "MediMate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MEDIMATE LOGO.png",
    "scheme": "medimate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow MediMate to use speech recognition to understand what you say.",
        "NSMicrophoneUsageDescription": "Allow MediMate to use the microphone to hear you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/MEDIMATE LOGO.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MediMate",
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MediMate to use the camera to scan your medicine."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow MediMate to use your location to share it in emergencies."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/MEDIMATE LOGO.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@jamsch/expo-speech-recognition",
        {
          "microphonePermission": "Allow MediMate to use the microphone to hear you.",
          "speechRecognitionPermission": "Allow MediMate to use speech recognition to understand what you say."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
